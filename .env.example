# Server-only secrets, mapped into runtimeConfig (nuxt.config.ts).
# Copy to .env for local development. .env is only read at dev/build time —
# deployed environments must set these as real environment variables.

NUXT_GROQ_API_KEY=
NUXT_GEMINI_API_KEY=
# Reranker (ADR-0007): groq-20b (default) | groq-120b | groq-qwen | gemini | off.
# NUXT_RERANK_MODEL=groq-20b
# Multi-query rewriting (ADR-0009): groq-20b (default) | groq-120b | groq-qwen | gemini | off.
# NUXT_EXPAND_MODEL=groq-20b
NUXT_SUPABASE_URL=
NUXT_SUPABASE_SERVICE_KEY=
# Bearer token for POST /api/ingest (operator-only until Phase 11). Empty = disabled.
NUXT_INGEST_TOKEN=
# Daily caps (ADR-0010). Defaults: chat 30 per client / 80 global, search 100 / 300.
# NUXT_QUOTA_CHAT_PER_CLIENT=30
# NUXT_QUOTA_CHAT_GLOBAL=80
# NUXT_QUOTA_SEARCH_PER_CLIENT=100
# NUXT_QUOTA_SEARCH_GLOBAL=300
# Behind a proxy, the header carrying the client IP (cf-connecting-ip, fly-client-ip, x-real-ip, x-forwarded-for).
# NUXT_TRUSTED_IP_HEADER=
# Langfuse tracing (Phase 10, TECH_NOTES §15). Both keys empty = tracing off.
# The SDK's standard names, read from the environment at run time.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU: https://cloud.langfuse.com · US: https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com
