# Server-only secrets, mapped into runtimeConfig (nuxt.config.ts).
# Copy to .env for local development. .env is only read at dev/build time —
# deployed environments must set these as real environment variables
# (Vercel: Project → Settings → Environment Variables; see docs/DEPLOYMENT.md).

NUXT_GROQ_API_KEY=
NUXT_GEMINI_API_KEY=
# Answer fallback on Cloudflare Workers AI (ADR-0005): the account id and a token
# with Workers AI scope only. Both empty = answers are Groq-only.
NUXT_CLOUDFLARE_ACCOUNT_ID=
NUXT_CLOUDFLARE_API_TOKEN=
# Reranker (ADR-0007): groq-20b (default) | groq-120b | groq-qwen | gemini | off.
# NUXT_RERANK_MODEL=groq-20b
# Multi-query rewriting (ADR-0009): groq-20b (default) | groq-120b | groq-qwen | gemini | off.
# NUXT_EXPAND_MODEL=groq-20b
NUXT_SUPABASE_URL=
NUXT_SUPABASE_SERVICE_KEY=
# Vercel cron secret for GET /api/cron/keep-alive (Production only; Vercel sends
# it as a bearer token). Set locally only to curl the route. Empty = route closed.
# CRON_SECRET=

# Bearer token for POST /api/ingest (operator-only until Phase 11). Empty = disabled.
# Leave it unset on Vercel: the corpus is ingested with `pnpm ingest:golden` (ADR-0011).
NUXT_INGEST_TOKEN=
# Per-minute limits and daily caps in Postgres (ADR-0010). Defaults: chat 10 a minute,
# 30 a day per client, 80 a day in all; search 30 / 100 / 300.
# Whole numbers only: anything else closes the route (logged at startup).
# NUXT_QUOTA_CHAT_PER_MINUTE=10
# NUXT_QUOTA_SEARCH_PER_MINUTE=30
# NUXT_QUOTA_CHAT_PER_CLIENT=10
# NUXT_QUOTA_CHAT_GLOBAL=80
# NUXT_QUOTA_SEARCH_PER_CLIENT=30
# NUXT_QUOTA_SEARCH_GLOBAL=300
# Behind a proxy, the header carrying the client IP (x-vercel-forwarded-for, cf-connecting-ip, fly-client-ip,
# x-real-ip, x-forwarded-for). Keys the daily caps and the per-minute limits. The origin must be reachable only
# through that proxy; behind a CDN and a host proxy, use the CDN's header (x-forwarded-for's last entry is the
# nearest proxy). On Vercel set x-vercel-forwarded-for (also the default there when unset; ADR-0011).
# NUXT_TRUSTED_IP_HEADER=
# Langfuse tracing (Phase 10, TECH_NOTES §15). Both keys empty = tracing off.
# The SDK's standard names, read from the environment at run time (on Vercel: plain env vars too).
# LANGFUSE_TRACING_ENVIRONMENT=production
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU: https://cloud.langfuse.com · US: https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com
