# Server-only secrets, mapped into runtimeConfig (nuxt.config.ts).
# Copy to .env for local development. .env is only read at dev/build time —
# deployed environments must set these as real environment variables.

NUXT_GROQ_API_KEY=
NUXT_GEMINI_API_KEY=
# Reranker (ADR-0007): groq-20b (default) | groq-120b | groq-qwen | gemini | off.
# NUXT_RERANK_MODEL=groq-20b
NUXT_SUPABASE_URL=
NUXT_SUPABASE_SERVICE_KEY=
# Bearer token for POST /api/ingest (operator-only until Phase 11). Empty = disabled.
NUXT_INGEST_TOKEN=
