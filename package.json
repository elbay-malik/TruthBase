{
  "name": "truthbase",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck && tsc -p tsconfig.scripts.json",
    "lint": "eslint .",
    "test": "vitest run",
    "render:highlights": "tsx scripts/render-highlights.ts",
    "ingest:golden": "tsx --env-file=.env scripts/ingest-golden.ts",
    "fixtures:highlights": "tsx scripts/build-highlight-fixtures.ts",
    "eval:answers": "tsx --env-file=.env scripts/eval-answers.ts",
    "check:viewer": "tsx --env-file=.env scripts/check-viewer.ts",
    "tune:retrieval": "tsx --env-file=.env scripts/tune-retrieval.ts",
    "eval:rerank": "tsx --env-file=.env scripts/eval-rerank.ts",
    "eval:multiquery": "tsx --env-file=.env scripts/eval-multiquery.ts",
    "fixtures:retrieval": "tsx --env-file=.env scripts/build-retrieval-fixture.ts",
    "eval:retrieval": "tsx scripts/eval-retrieval.ts",
    "eval:llm": "pnpm dlx promptfoo@0.124.1 eval -c scripts/promptfoo/promptfooconfig.yaml --no-cache -o .cache/promptfoo-results.json",
    "eval:llm:summary": "tsx --env-file-if-exists=.env scripts/promptfoo/summary.ts",
    "sample:traces": "tsx --env-file=.env scripts/sample-traces.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.9",
    "@ai-sdk/groq": "4.0.5",
    "@ai-sdk/provider": "4.0.2",
    "@ai-sdk/vue": "4.0.17",
    "@langfuse/otel": "6.0.1",
    "@langfuse/tracing": "6.0.1",
    "@langfuse/vercel-ai-sdk": "6.0.1",
    "@nuxt/ui": "^4.12.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/otlp-exporter-base": "0.223.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "@supabase/supabase-js": "^2.110.1",
    "@vueuse/core": "^14.3.0",
    "@vueuse/nuxt": "^14.3.0",
    "ai": "7.0.17",
    "nuxt": "^4.6.1",
    "nuxt-security": "^2.6.0",
    "pdfjs-dist": "6.4.299",
    "tailwindcss": "^4.3.2",
    "unpdf": "1.9.0",
    "vue": "^3.5.44",
    "vue-router": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.145",
    "@napi-rs/canvas": "^1.0.11",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.3",
    "@types/node": "^24.19.2",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.6.0",
    "happy-dom": "^20.10.6",
    "playwright-core": "^1.61.1",
    "postgres": "^3.4.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.6"
  }
}
